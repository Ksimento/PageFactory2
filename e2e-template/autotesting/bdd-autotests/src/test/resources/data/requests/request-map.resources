# получение списка параметров конфигурации приложения
parametersEditorGetConfigs = {"operationName":"parametersEditorGetConfigs","variables":{"frontConfigurationInput":[{"propertyCode":"front.student.profile.version.name","defaultValue":"v1"},{"propertyCode":"front.student.module.design.version.name","defaultValue":"v1"},{"propertyCode":"front.student.module.playlist.design.version.name","defaultValue":"0"},{"propertyCode":"front.studentCalendar.enabled","defaultValue":"true"},{"propertyCode":"front.min.safari.version","defaultValue":"13.0.3"},{"propertyCode":"front.error.report.history.enabled","defaultValue":"true"},{"propertyCode":"front.mediateka.sberbox.enabled","defaultValue":"false"},{"propertyCode":"edu.service.administration.videoconference.enabled","defaultValue":"false"},{"propertyCode":"edu.service.catalog.module.collections.enabled","defaultValue":"false"},{"propertyCode":"edu.service.catalog.selections.edit","defaultValue":"false"}],"entityIdList":[],"userId":null},"query":"query parametersEditorGetConfigs($frontConfigurationInput: [FrontConfigurationInput!]!, $entityIdList: [ID!]!, $userId: ID) {\n  systemAdmin {\n    getAllBackendConfigurations(entityIdList: $entityIdList, userId: $userId) {\n      ...ParametersEditorConfiguration\n      __typename\n    }\n    getConfigurations(frontConfigurationInput: $frontConfigurationInput, entityIdList: $entityIdList, userId: $userId) {\n      propertyCode\n      value\n      entityId\n      __typename\n    }\n    __typename\n  }\n}\n\nfragment ParametersEditorConfiguration on Configuration {\n  propertyCode\n  value\n  entityId\n  configurationMeta {\n    ...ParametersEditorConfigurationMeta\n    __typename\n  }\n  __typename\n}\n\nfragment ParametersEditorConfigurationMeta on ConfigurationMeta {\n  type\n  possibleValues {\n    value\n    displayableName\n    __typename\n  }\n  maxLength\n  minLength\n  regex\n  displayableName\n  groupDisplayableName\n  __typename\n}\n"}

# создание пользователя СА + КС Школа АТ
