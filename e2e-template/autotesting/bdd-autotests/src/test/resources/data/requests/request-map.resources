# "SUBJECT_FULL_NAME"
# "ORG_UNIT_ID"
admin.create.subject = {"operationName":"subjectsEditorSaveSubjects","variables":{"subjects":[{"name":"SUBJECT_NAME","fullName":"SUBJECT_FULL_NAME","colour":null,"avatar":null,"orgUnitId":"ORG_UNIT_ID"}]},"query":"mutation subjectsEditorSaveSubjects($subjects: [SubjectInput!]!) {\n  systemAdmin {\n    saveSubjects(subjects: $subjects) {\n      id\n      name\n      fullName\n      __typename\n    }\n    __typename\n  }\n}\n"}

# создание меты задания (без контента) под СА
# TASK_TITLE
admin.task.meta.create = {"operationName":"saveTask","variables":{"taskMeta":{"title":"TASK_TITLE","type":"TRAINING","checkType":"BY_TEACHER","attemptsNumber":3,"unlimitedAttempts":true,"assignmentType":"INDIVIDUAL","laboriousness":5,"softSkillTypes":[],"author":"Сисадмин Автотесты","licenseId":"1","links":"","pedagogicalTechniqueId":"","info":"","infoAttachmentFiles":[],"studentHint":"","teacherHint":"","attachmentFiles":[],"code":"","archived":false,"note":"","scope":{"code":"PRIVATE","schools":[],"users":[]},"tags":[],"taskCriteriaInput":[],"coAuthorIds":[]},"content":{"taskContent":"","pages":[],"contentType":"HTML"}},"query":"mutation saveTask($taskId: ID, $taskMeta: TaskMetaInput, $content: ContentInput, $linkModuleAndLevel: LinkModuleAndLevelInput, $linkSlot: LinkSlotInput) {\n  workshop {\n    saveTask(taskId: $taskId, taskMeta: $taskMeta, content: $content, linkModuleAndLevel: $linkModuleAndLevel, linkSlot: $linkSlot) {\n      id\n      content {\n        id\n        type\n        body\n        external {\n          id\n          contentLoad {\n            id\n            contentProvider {\n              id\n              name\n              description\n              externalContentProvider\n              __typename\n            }\n            created\n            description\n            __typename\n          }\n          contentProviderId\n          taskType\n          taskTypeId\n          taskName\n          subject\n          subjectId\n          stage\n          version\n          api\n          hash\n          jsonMeta\n          externalId\n          url\n          path\n          config\n          __typename\n        }\n        pages {\n          pageId\n          pageNumber\n          sections {\n            widgets {\n              widgetId\n              widgetNumber\n              contentWidgetType\n              body\n              __typename\n            }\n            __typename\n          }\n          __typename\n        }\n        __typename\n      }\n      modifyTime\n      modifyUser {\n        id\n        lastName\n        firstName\n        middleName\n        __typename\n      }\n      __typename\n    }\n    __typename\n  }\n}\n"}

# изменение даты в существующей контрольной
# CLASS_SUBJECT_CONTROL_WORK_ID
# PLAN_TIME
teacher.update.date.controlwork = {"operationName":"setControlWorkPlanTime","variables":{"classSubjectControlWorkId":"CLASS_SUBJECT_CONTROL_WORK_ID","planTime":"PLAN_TIME"},"query":"mutation setControlWorkPlanTime($classSubjectControlWorkId: ID!, $planTime: DateTime!) {\n  teacher {\n    setControlWorkPlanTime(classSubjectControlWorkId: $classSubjectControlWorkId, planTime: $planTime) {\n      ...ControlWorkCommonFragment\n      __typename\n    }\n    __typename\n  }\n}\n\nfragment ControlWorkCommonFragment on ClassSubjectControlWork {\n  id\n  name\n  classSubjectName\n  classSubjectId\n  module {\n    id\n    title\n    __typename\n  }\n  planTime\n  startTime\n  closeTime\n  duration\n  comment\n  status\n  createTime\n  modifyTime\n  variants {\n    id\n    number\n    tasks {\n      id\n      title\n      parentTaskId\n      __typename\n    }\n    __typename\n  }\n  visible\n  totalNumberOfStudents\n  numberOfStudentsWithVariants\n  __typename\n}\n"}

# запуск контрольной работы
# CLASS_SUBJECT_CONTROL_WORK_ID
teacher.start.controlwork = {"operationName":"changeControlWorkStatus","variables":{"classSubjectControlWorkId":"CLASS_SUBJECT_CONTROL_WORK_ID","newStatus":"STARTED"},"query":"mutation changeControlWorkStatus($classSubjectControlWorkId: ID!, $newStatus: ControlWorkStatus!) {\n  teacher {\n    changeControlWorkStatus(classSubjectControlWorkId: $classSubjectControlWorkId, newStatus: $newStatus) {\n      ...ControlWorkCommonFragment\n      __typename\n    }\n    __typename\n  }\n}\n\nfragment ControlWorkCommonFragment on ClassSubjectControlWork {\n  id\n  name\n  classSubjectName\n  classSubjectId\n  module {\n    id\n    title\n    __typename\n  }\n  planTime\n  startTime\n  closeTime\n  duration\n  comment\n  status\n  createTime\n  modifyTime\n  variants {\n    id\n    number\n    tasks {\n      id\n      title\n      parentTaskId\n      __typename\n    }\n    __typename\n  }\n  visible\n  totalNumberOfStudents\n  numberOfStudentsWithVariants\n  __typename\n}\n"}

# завершение контрольной работы
# CLASS_SUBJECT_CONTROL_WORK_ID
teacher.end.controlwork = {"operationName":"changeControlWorkStatus","variables":{"classSubjectControlWorkId":"CLASS_SUBJECT_CONTROL_WORK_ID","newStatus":"CLOSED"},"query":"mutation changeControlWorkStatus($classSubjectControlWorkId: ID!, $newStatus: ControlWorkStatus!) {\n  teacher {\n    changeControlWorkStatus(classSubjectControlWorkId: $classSubjectControlWorkId, newStatus: $newStatus) {\n      ...ControlWorkCommonFragment\n      __typename\n    }\n    __typename\n  }\n}\n\nfragment ControlWorkCommonFragment on ClassSubjectControlWork {\n  id\n  name\n  classSubjectName\n  classSubjectId\n  module {\n    id\n    title\n    __typename\n  }\n  planTime\n  startTime\n  closeTime\n  duration\n  comment\n  status\n  createTime\n  modifyTime\n  variants {\n    id\n    number\n    tasks {\n      id\n      title\n      parentTaskId\n      __typename\n    }\n    __typename\n  }\n  visible\n  totalNumberOfStudents\n  numberOfStudentsWithVariants\n  __typename\n}\n"}

# изменение feature flag в конфигурации
# PROPERTY_CODE
# VALUE
# ENTITY_ID
admin.save.configuration = {"operationName":"systemAdminSaveConfiguration","variables":{"configuration": [{"propertyCode":"PROPERTY_CODE", "value": "VALUE","entityId": "ENTITY_ID","userId":null}]},"query":"mutation systemAdminSaveConfiguration($configuration: [ConfigurationInput!]!) {systemAdmin{ saveConfiguration( configuration:$configuration, deletedConfiguration:[])}}"}

# получение feature flag из конфигурации
# PROPERTY_CODE
# VALUE
# ENTITY_ID
admin.get.configuration = {"operationName":"systemAdminGetConfiguration","variables": {"frontConfigurationInput": { "propertyCode": "PROPERTY_CODE", "defaultValue": "VALUE"}, "entityIdList": "ENTITY_ID"}, "query":"query systemAdminGetConfiguration($frontConfigurationInput: [FrontConfigurationInput!]!, $entityIdList: [ID!]!) {systemAdmin {getConfigurations(frontConfigurationInput: $frontConfigurationInput, entityIdList: $entityIdList){propertyCode, value}}}"}

# размещение студента в кластере
# IDEMPOTENCY_KEY
# SESSION
# LOGIN
# CAMPUS
# HOST
# EVENT
# CREATED_TIME
admin.cluster.student = {"idempotency_key": "IDEMPOTENCY_KEY", "session_id": "SESSION", "login": "LOGIN", "campus_id": "CAMPUS", "host_name": "HOST", "event_type": "EVENT", "created_time": "CREATED_TIME"}

# Студент. Создание time slot для проверки
# START_TIME
# END_TIME
student.mutation.addEventToTimetable = {"operationName":"studentAddEventToTimetable", "variables":{"start": "START_TIME", "end":"END_TIME"}, "query":"mutation studentAddEventToTimetable($start: DateTime!, $end: DateTime!) { student { addEventToTimetable(start: $start, end:$end){id} } }"}

# Студент. Получение номера ответа на задание.
# TASK_ID
student.query.getTaskAnswers = {"operationName":"studentGetTaskAnswers", "variables":{"taskId": "TASK_ID"}, "query":"query studentGetTaskAnswers($taskId: ID!) {student {getTaskAnswers (taskId:$taskId) {id} }}"}

# Студент. Запись задания на проверку
# START_TIME
# ANSWER_ID
student.query.addBookingToEventSlot = {"operationName":"studentAddBookingToEventSlot", "variables":{"startTime": "START_TIME", "answerId":"ANSWER_ID"}, "query":"mutation studentAddBookingToEventSlot($startTime: DateTime!, $answerId: ID!){ student {addBookingToEventSlot(startTime: $startTime, answerId:$answerId){id} }}"}


# Учитель. Домашние задания
# ENTITY_ID
# PROPERTY_CODE
# VALUE
admin.query.parametersSaveConfiguration = {"operationName":"parametersSaveConfiguration","variables":{"configuration":[{"entityId":"ENTITY_ID","propertyCode":"PROPERTY_CODE","value":"VALUE","userId":null}],"deletedConfiguration":[]},"query":"mutation parametersSaveConfiguration($configuration: [ConfigurationInput!]!, $deletedConfiguration: [ConfigurationDeleteInput!]) {\n  systemAdmin {\n    saveConfiguration(configuration: $configuration, deletedConfiguration: $deletedConfiguration)\n    __typename\n  }\n}\n"}
