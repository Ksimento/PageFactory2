# USER_MIDDLE_NAME
# USER_LAST_NAME
# USER_LOGIN
# USER_EMAIL
# USER_PHONE (номер телефона в формате 79529477733 без + вначале!)
user.create.SA_KS.school_AT = {"operationName":"userEditorSystemAdminSaveUser","variables":{"user":{"firstName":"USER_FIRST_NAME","middleName":"USER_MIDDLE_NAME","lastName":"USER_LAST_NAME","login":"USER_LOGIN","status":"ACTIVE","email":"USER_EMAIL","mobilePhone":"USER_PHONE","parentRoles":[],"businessAdminRoles":[{"status":"ACTIVE","schoolId":"60714926-3d5b-41b4-af39-4a08bc1c5ffa"}],"systemAdminRole":{"status":"ACTIVE"},"newAndUpdatedFunctionalRoles":[{"code":"BASE_ROLE","schoolId":null,"dateEnd":null,"dateStart":null},{"code":"BUSINESS_ADM","schoolId":"60714926-3d5b-41b4-af39-4a08bc1c5ffa","dateEnd":null,"dateStart":null},{"code":"TEACHER_MARK_STATISTICS","schoolId":"60714926-3d5b-41b4-af39-4a08bc1c5ffa","dateEnd":null,"dateStart":null},{"code":"BUSINESS_STATISTICS","schoolId":"60714926-3d5b-41b4-af39-4a08bc1c5ffa","dateEnd":null,"dateStart":null},{"code":"SCHOOL_USERS_ADM","schoolId":"60714926-3d5b-41b4-af39-4a08bc1c5ffa","dateEnd":null,"dateStart":null},{"code":"BASE_ROLE","schoolId":"60714926-3d5b-41b4-af39-4a08bc1c5ffa","dateEnd":null,"dateStart":null},{"code":"CONTENT_BASE","schoolId":"60714926-3d5b-41b4-af39-4a08bc1c5ffa","dateEnd":null,"dateStart":null}],"deletedFunctionalRoles":[]}},"query":"mutation userEditorSystemAdminSaveUser($user: UserInput!) {\n  systemAdmin {\n    saveUser(user: $user) {\n      ...UserEditorSaveUserResult\n      __typename\n    }\n    __typename\n  }\n}\n\nfragment UserEditorSaveUserResult on User {\n  id\n  studentRoles {\n    ...UserEditorSaveUserStudentRole\n    __typename\n  }\n  __typename\n}\n\nfragment UserEditorSaveUserStudentRole on StudentRole {\n  id\n  schoolId\n  __typename\n}\n"}

