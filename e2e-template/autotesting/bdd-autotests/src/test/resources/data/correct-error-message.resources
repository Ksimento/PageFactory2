# для добавления ошибки в исключения для всех тестов, название
# ошибки необходимо начинать с префикса all_
# В иных случаях ошибка будет игнорироваться только в тестах, в которых
# она явно указана через тег
# @errors:message1,message2
#
# или список тегов
# @error:message3
# @error:message4

 message1 = Текущий пользователь не имеет права проверять данное задание или учебный модуль студента
 message2 = В контрольную работу невозможно добавить задание с типом проверки
 message3 = Невозможно добавить в контрольную работу мотивирующее задание
 message4 = Редактируемое задание добавлено в контрольную работу. Изменение типа проверки на
 message5 = Невозможно начать в классе две контрольные работы одновременно
 message6 = Невозможно изменять или удалять контрольную работу, которая закончилась или идёт в данный момент
 message7 = Невозможно изменять персональный план, так как вы не преподаёте у ученика
 message8 = Для пользователя с ролью Системный администратор обязательна роль Конфигуратор системы
 message9 = Нельзя отправить задание на проверку после истечения дедлайна
 access_denied = *Запрещен доступ пользователю*
 no_delete_model = *Невозможно удалить модуль, так как для него есть запущенная или запланированная контрольная работа*
 all_audit_message_over_5000 = *Найдено более '5 000' строк. Конкретизируйте параметры поиска*
 contacts_is_not_defined = ReferenceError: Contacts is not defined*
 Invariant_Violation = *Invariant Violation: 17*
 Failed_to_fetch = TypeError: Failed to fetch
 TypeError_focus = TypeError: Cannot read property 'focus' of undefined*
 Minified_Error = *Minified React error*
